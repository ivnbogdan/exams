# Copy to .env.local and fill in. Never commit .env.local.
# Neon Postgres pooled connection string (from Vercel -> Storage -> Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exams-ro-files
# https://files.exams.ro once DNS is live; the temporary r2.dev URL until then
R2_PUBLIC_BASE_URL=https://files.exams.ro
# Public site URL
NEXT_PUBLIC_SITE_URL=https://exams.ro
# Local only: absolute path to the export folder used by `pnpm seed`
EXPORT_DIR=/absolute/path/to/exams-ro-export
